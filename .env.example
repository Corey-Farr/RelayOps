# Do not copy sample secrets. `python scripts/demo.py init` generates .env once.
# .env and .local/ are ignored by Git. Do not expose the demo stack publicly.
APP_ENV=demo
POSTGRES_PASSWORD=
SESSION_SECRET=
# URL-safe base64 encoding of 32 random bytes (Fernet key).
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@relayops.local
ADMIN_PASSWORD=
DEMO_SIGNING_SECRET=
DEMO_CONTROL_TOKEN=
DEMO_SINK_URL=http://demo-sink:8081
GRAFANA_PASSWORD=
# Docker Compose sets DATABASE_URL using POSTGRES_PASSWORD and the service name.
# Native development: postgresql+asyncpg://user:password@127.0.0.1:5432/relayops
# Optional: WORKER_CONCURRENCY=8, WORKER_REGION=us-east, WORKER_ID=native-worker
